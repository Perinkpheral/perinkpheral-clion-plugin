<idea-plugin>
    <id>dev.perinkpheral.clion</id>
    <name>perINKpheral</name>
    <vendor url="https://github.com/Perinkpheral/perinkpheral-os">Perinkpheral</vendor>
    <description><![CDATA[
        <p>Development tools for the perINKpheral desk display.</p>
        <ul>
            <li>Toolchain setup: SDK checkout and wasi-sdk are downloaded on request.</li>
            <li>CMake project setup: the plugin offers to create or replace CMakeLists.txt so the project reads SDK and wasi-sdk paths from the plugin settings.</li>
            <li>Run configuration and Upload to Device: build an application, install it on the device and restart the device into it.</li>
            <li>Device tool window: live screen, buttons, log and status.</li>
            <li>Simulator on macOS and Linux: an application runs on this computer in the firmware's own interpreter and kit, in the foreground and in the background, with intents, alarms and mocked answers.</li>
            <li>Validation and completion for <code>manifest.json</code>.</li>
            <li>Firmware upload over the network and over USB.</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable parentId="tools"
                                 instance="dev.perinkpheral.clion.settings.PerinkpheralConfigurable"
                                 id="dev.perinkpheral.clion.settings"
                                 displayName="perINKpheral"/>
        <toolWindow id="perINKpheral" anchor="right" icon="/META-INF/pluginIcon.svg"
                    factoryClass="dev.perinkpheral.clion.device.DeviceToolWindowFactory"/>
        <configurationType implementation="dev.perinkpheral.clion.run.AppRunConfigurationType"/>
        <runConfigurationProducer implementation="dev.perinkpheral.clion.run.AppRunConfigurationProducer"/>
        <notificationGroup id="perINKpheral" displayType="BALLOON"/>
        <postStartupActivity implementation="dev.perinkpheral.clion.project.AppProjectActivity"/>
    </extensions>

    <extensions defaultExtensionNs="JavaScript.JsonSchema">
        <ProviderFactory implementation="dev.perinkpheral.clion.manifest.ManifestSchemaProviderFactory"/>
    </extensions>

    <actions>
        <group id="dev.perinkpheral.clion.Menu" text="perINKpheral" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="dev.perinkpheral.clion.SetUpToolchain"
                    class="dev.perinkpheral.clion.toolchain.SetUpToolchainAction"
                    text="Set Up Toolchain"
                    description="Download the SDK and wasi-sdk if they are missing"/>
            <action id="dev.perinkpheral.clion.NewApplication"
                    class="dev.perinkpheral.clion.run.NewApplicationAction"
                    text="New Application..."
                    description="Create an application folder from the SDK sample"/>
            <action id="dev.perinkpheral.clion.UploadToDevice"
                    class="dev.perinkpheral.clion.run.UploadToDeviceAction"
                    text="Upload to Device"
                    description="Build the application, install it on the device and restart the device into it">
                <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
                <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            </action>
            <separator/>
            <action id="dev.perinkpheral.clion.FlashNetwork"
                    class="dev.perinkpheral.clion.firmware.FlashOverNetworkAction"
                    text="Upload Firmware over Network"
                    description="Choose a main firmware image and upload it through recovery"/>
            <action id="dev.perinkpheral.clion.FlashUsb"
                    class="dev.perinkpheral.clion.firmware.FlashOverUsbAction"
                    text="Upload Firmware over USB..."
                    description="Write selected main firmware to ota_0 with esptool; settings and applications are kept. Press BACK in recovery to start it"/>
        </group>
    </actions>
</idea-plugin>
